#version 450

layout(local_size_x = 8, local_size_y = 8) in;

layout(binding = 0, rgba8) uniform readonly image2D img;
layout(std430, binding = 1) buffer Out {
	uint pixels[];
};

void main()
{
	ivec2 p = ivec2(gl_GlobalInvocationID.xy);
	int w = imageSize(img).x;
	if (p.x >= w || p.y >= imageSize(img).y)
		return;
	pixels[p.y * w + p.x] = packUnorm4x8(imageLoad(img, p));
	if (p == ivec2(0)) {
		pixels[w * imageSize(img).y] = uint(imageSize(img).x);
		pixels[w * imageSize(img).y + 1] = uint(imageSize(img).y);
	}
}
