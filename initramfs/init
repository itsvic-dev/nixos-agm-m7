#!/bin/busybox sh
/bin/busybox mkdir -p /bin /sbin /usr/bin /usr/sbin /proc /sys /dev /tmp /run /etc /var
/bin/busybox --install -s
mount -t proc proc /proc
mount -t sysfs sysfs /sys
mount -t devtmpfs devtmpfs /dev 2>/dev/null
mkdir -p /dev/pts && mount -t devpts devpts /dev/pts

log() { echo "<0>agm-m7: $*" > /dev/kmsg; }
log "busybox init"

udc_state() { cat /sys/class/udc/*/state 2>/dev/null; }

for i in $(seq 1 60); do
	[ "$(udc_state)" = configured ] && break
	sleep 1
done
log "udc: $(ls /sys/class/udc 2>/dev/null) state: $(udc_state)"

if [ "$(udc_state)" != configured ]; then
	log "no USB host, rebooting"
	sleep 2
	reboot -f
fi

(sleep 300; [ -e /tmp/stay ] || { log "no /tmp/stay after 300 s, rebooting"; reboot -f; }) &
safety=$!

hostname agm-m7
ifconfig lo 127.0.0.1 up
ifconfig usb0 172.16.42.1 netmask 255.255.255.0 up
cat > /etc/udhcpd.conf <<CONF
start 172.16.42.2
end 172.16.42.2
interface usb0
max_leases 1
pidfile /tmp/udhcpd.pid
lease_file /tmp/udhcpd.leases
option subnet 255.255.255.0
CONF
touch /tmp/udhcpd.leases
udhcpd -f /etc/udhcpd.conf 2>&1 | while read -r l; do log "udhcpd: $l"; done &
telnetd -l /bin/sh
log "usb0: $(ifconfig usb0 | grep inet)"

boot_pmos() {
	[ -f /etc/userdata.table ] || return 1
	dmctl create userdata rw "$(cat /etc/userdata.table)" >/dev/null || return 1
	mkdir -p /data
	mount -t f2fs /dev/dm-0 /data || return 1
	if [ ! -f /data/pmos.img ] || [ -e /data/pmos.disable ]; then
		log "pmos: no /data/pmos.img or /data/pmos.disable set"
		return 1
	fi
	log "pmos: booting in 10 s, touch /tmp/nopmos to stop"
	sleep 10
	[ -e /tmp/nopmos ] && { log "pmos: stopped by /tmp/nopmos"; return 1; }

	mkdir -p /newroot
	loopdev=$(losetup -f) && losetup "$loopdev" /data/pmos.img || return 1
	mount -t ext4 "$loopdev" /newroot || return 1
	mkdir -p /newroot/mnt/data
	mount --move /data /newroot/mnt/data
	kill "$safety" 2>/dev/null
	killall udhcpd telnetd 2>/dev/null
	umount /dev/pts
	mount --move /dev /newroot/dev
	mount --move /proc /newroot/proc
	mount --move /sys /newroot/sys
	log "pmos: switch_root"
	exec switch_root /newroot /sbin/init
}

boot_pmos

while true; do
	setsid -c sh -l </dev/ttyGS0 >/dev/ttyGS0 2>&1
	sleep 1
done
